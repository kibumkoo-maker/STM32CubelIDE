	          // [중요] Out of Range 문구도 서버가 인식합니다.
	          printf("Out of Range!\r\n");
	      }

	      HAL_Delay(100); // 센서 안정화 및 데이터 전송 간격 유지
    /* USER CODE END WHILE */

    /* USER CODE BEGIN 3 */
